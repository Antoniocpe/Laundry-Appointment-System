#mainWindow {
    background-color: #ebf1fa;
}

QLabel {
    color: #303030;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 15px;
}

#sidebar_layout {
    background-color: #b6c9e0;
    color: #fcfeff;
}

QPushButton[SidebarBtnClass="sidebar-buttons"] {
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
}

QPushButton[SidebarBtnClass="sidebar-buttons"]:hover{
    background-color: transparent;
    border-bottom: 3px solid #d3e5ef;
}

QPushButton[SidebarBtnClass="sidebar-buttons"]:checked {
    background-color: transparent;
    border-bottom: 3px solid #fcfeff;
}

#header {
    font-size: 29px;
    font-weight: bold;
    color: #3c5670;
    text-transform: uppercase;
}
