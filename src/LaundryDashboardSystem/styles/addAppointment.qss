#addappointment_qss {
    background-color: #FFFFFF;
}

#addappointment_qss QWidget {
    color: #1e293b;
    background-color: #FFFFFF;
}

#addappointment_qss QLabel {
    font-size: 12px;
    background-color: #FFFFFF;
}

#addappointment_qss QLabel[tag="sectionLabel"]{
    color: black;
    font-size: 18px;
    font-weight: bold;
    padding-top: 2px;
    padding-left: 7px;
}

#addappointment_qss QLabel[tag="widgetLabel"]{
    color: black;
    font-size: 15px;
    padding: 2px;
}

#addappointment_qss QLineEdit {
    background-color: white;
    border: 1.3px solid #a8a8a8;
    border-radius: 8px;
    padding: 5px;
}

#addappointment_qss QLineEdit::hover{
    border-color: #22588d;
}

#addappointment_qss QLineEdit::focus{
    border: 1.5px solid #084a8b;;
}

#addappointment_qss QPushButton[tag="schedule_button"]{
    border: 1.5px solid #a8a8a8;
    border-radius: 23px;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-left: 10px;
    margin-top: 5px;
    
    color: #a8a8a8;
    font-size: 13px;
    font-weight: bold;
    text-align: center;
    background-color: #FFFFFF;
}

#addappointment_qss QPushButton[tag="schedule_button"]:hover{
    color: #22588d;
    border: 1.5px solid #22588d;
}

#addappointment_qss QPushButton[tag="schedule_button"]:checked{
    color: #22588d;
    border: 1.75px solid #22588d;
}

#addappointment_qss QRadioButton{
    color: #181818;
    font-size: 14px;
    spacing: 8px;
    margin-left: 10px;
    background: transparent;
}

#addappointment_qss QRadioButton::indicator { 
    width: 12px;
    height: 12px;
    border-radius: 6px; 
    border: 1.3px solid #a8a8a8;
    background-color: #ffffff;
}

#addappointment_qss QRadioButton::indicator:checked {
    border-radius: 6px; 
    border: 1.4px solid #76b7f8;
    background-color: #deedfb; 
}

#addappointment_qss QRadioButton::indicator:unchecked { 
    background-color:transparent; 
}

#addappointment_qss QCheckBox{
    color: #181818;
    font-size: 14px;
    spacing: 8px;
    margin-left: 10px;
    background: transparent;
}

#addappointment_qss QCheckBox::indicator { 
    width: 12px;
    height: 12px;
    border-radius: 6px; 
    border: 1.3px solid #a8a8a8;
    background-color: #ffffff;
}

#addappointment_qss QCheckBox::indicator:checked {
    border-radius: 6px; 
    border: 1.4px solid #76b7f8;
    background-color: #deedfb; 
}

#addappointment_qss QCheckBox::indicator:unchecked { 
    background-color:transparent; 
}

#addappointment_qss #header_layout {
    background-color: #ebf1fa;
    min-height: 75px;
    max-height: 75px;
}

#addappointment_qss #back_btn {
    background-color: transparent;
}

#addappointment_qss #header_text {
    background-color: #ebf1fa;
    color: #3c5670;
    font-size: 29px;
    font-weight: bold;
}

#addappointment_qss #confirm_btn {
    background-color: #22588d;
    font-weight: bold;
    font-size: 18px;
    color: #FCFFFF;
    padding: 5px;
    border-radius: 11px;
    
}

#addappointment_qss #confirm_btn::hover {
    background-color: #47739e;
}

#addappointment_qss #confirm_btn:pressed {
    background-color: #085eb4;

}

#addappointment_qss #inputDetails_layout {
    background-color: #FFFFFF;
}

#addappointment_qss #progress_layout{
    background-color: #FFFFFF;
}

#addappointment_qss #services_layout{
    background-color: #FFFFFF;
}

#addappointment_qss #specification_layout{
    background-color: #FFFFFF;
}

#addappointment_qss #schedule_layout{
    background-color: #FFFFFF;
}