QWidget {
    background-color: #ebf1fa;
}

QLabel { 
    color: #303030; 
    background-color: transparent; 
} 


#Dashboard_style #header {
    font-size: 26px; 
    font-weight: 800; 
    color: #2c4d70; 
} 

QPushButton#addApptBtn { 
    border: none;
    border-radius: 8px;
    padding: 8px;
    font-weight: bold;
    background-color: #6491bf;
    text-align: center;
    color: #fcfeff;
    margin-right: 20px;
} 

QPushButton#addApptBtn:hover { 
    background-color: #5582ad; 
} 

QPushButton#addApptBtn:pressed {
    background-color: #4a739d; 
} 

#inQueue_text { 
    font-size: 14px; 
    font-weight: bold; 
    color: #1f2d3d; 
} 

#total_text { 
    font-size: 12px; 
    color: #4a4a4a; 
} 


QFrame#washers_panel { 
    background-color: #ffffff; 
    border-radius: 16px; 
} 


QWidget#customerCard { 
    background-color: transparent; 
    border: 2px solid transparent; 
    border-radius: 12px; 
} 

QWidget#customerCard[selected="true"] { 
    background-color: #f1f6fc; 
    border: 2px solid #b6c9e0; 
} 

#customer_name { 
    font-size: 12px; 
    font-weight: bold; 
    color: #2c3e50; 
} 

#cardLine { 
    background-color: #c8cfd8; 
    border: none; 
} 


QFrame#details_layout { 
    background-color: #ffffff; 
} 

#details_stack, 
#details_page { 
    background-color: transparent; 
} 

#details_placeholder { 
    color: #939393; 
    font-size: 15px; 
} 

#details_title { 
    font-size: 14px; 
    font-weight: bold; 
    color: #2c4d70; 
} 

QLabel[tag="sectionTitle"] { 
    font-size: 12px; 
    font-weight: bold; 
    color: #1f2d3d; 
} 

QLabel[tag="fieldLabel"] { 
    font-size: 12px; 
    color: #303030;
}

QLabel[tag="fieldValue"] { 
    font-size: 12px; 
    color: #5a5a5a; 
} 


QComboBox#statusCombo { 
    background-color: #e5484d;           
    color: #ffffff; 
    border: none;
    border-radius: 8px;
    padding: 6px 12px; 
    min-height: 22px; 
    font-size: 13px; 
    font-weight: bold;
}

QComboBox#statusCombo[status="progress"] { 
    background-color: #f0a93a; 
}

QComboBox#statusCombo[status="pickup"] { 
    background-color: #5fc75f; 
}

QComboBox#statusCombo::drop-down { 
    subcontrol-origin: padding; 
    subcontrol-position: center right; 
    width: 32px; 
    border: none; 
    background: transparent; 
}

QComboBox QAbstractItemView { 
    background-color: #ffffff; 
    color: #303030; 
    border: 1px solid #c8cfd8; 
    selection-background-color: #dbe7f5; 
    selection-color: #303030; 
    outline: 0; 
} 